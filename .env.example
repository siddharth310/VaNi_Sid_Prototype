NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
VITE_AUTO_AGENT_URL=https://respect-rickety-lilly.ngrok-free.dev/v1/agents/auto

# Optional override for wsUrl host in POST /api/voice/session/start (defaults to localhost:PORT)
# PUBLIC_WS_HOST=localhost:3001

DATABASE_URL=postgresql://vhos:vhos@localhost:5432/vhos
REDIS_URL=redis://localhost:6379

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ROUTING_MODEL=gpt-4o-mini

# Voice provider: openai | elevenlabs
VOICE_PROVIDER=openai

OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_DEFAULT_VOICE=alloy

ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_AGENT_ID=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# Auth / PHI — use a long random string (32+ chars)
PATIENT_HASH_SECRET=change-me-please-use-32-plus-chars-minimum
OTP_EXPIRY_SECONDS=120
MAX_AUTH_ATTEMPTS=3

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FHIR_BASE_URL=
FHIR_AUTH_TOKEN=

SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=

PROMETHEUS_PORT=9090
